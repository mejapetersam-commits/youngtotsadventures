{
  "buildCommand": "pnpm run typecheck && pnpm --filter ./artifacts/api-server --filter ./artifacts/summer-safari run build",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...path]?path=:path*" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/dashboard", "destination": "/index.html" },
    { "source": "/admin/reviews", "destination": "/index.html" },
    { "source": "/admin/registrations/:id(\\d+)", "destination": "/index.html" }
  ]
}
